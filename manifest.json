{
  "manifest_version": 3,
  "name": "Jisuke",
  "version": "1.0.0",
  "description": "Jisuke adds rōmaji above Japanese text using Ruby annotations.",

  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "permissions": [],
  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["style.css"],
      "js": [
        "lib/wanakana.min.js", 
        "lib/kuromoji.js",
        
        "src/ruby.js",
        "src/tokenizer.js",

        "main.js",

        "view/hover.js"
      ],

      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/*"],
      "matches": ["<all_urls>"]
    }
  ]
}